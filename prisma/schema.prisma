generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  boards Board[]
}

model Board {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  columns   Column[]

  @@index([userId])
}

model Column {
  id        String   @id @default(cuid())
  name      String
  position  Int

  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  tasks     Task[]

  @@index([boardId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  position    Int

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  columnId    String
  column      Column       @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId])
}